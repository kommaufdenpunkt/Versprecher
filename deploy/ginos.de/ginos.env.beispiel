# Umgebung für den Betrieb unter ginos.de.
# Kopieren nach /etc/ginos.env, Rechte einschränken (chmod 600), Werte anpassen.
# Diese Datei enthält Geheimnisse und gehört NICHT ins Repository.

# Die Anwendung lauscht nur lokal; nach außen geht es über Caddy (HTTPS).
PORT=8080

# Datenbank (App-Rolle, nur DML — DDL läuft über die Migrationen als Superuser).
DATABASE_URL=postgres://insider_app:HIER-EIN-ECHTES-PASSWORT@127.0.0.1:5432/insider

# PFLICHT: langes Zufallsgeheimnis. Erzeugen mit:
#   openssl rand -base64 48
JWT_SECRET=HIER-EIN-LANGES-ZUFALLSGEHEIMNIS-EINSETZEN
JWT_TTL=720h

# Caddy sitzt davor: nur ihm vertrauen, sonst käme die falsche Client-IP an
# und das Rate-Limit ließe sich aushebeln.
TRUSTED_PROXIES=127.0.0.1

# ------------------------------------------------------------------
# Fahrstunden-Nachweis
# ------------------------------------------------------------------

# Eigene Domain: die Oberfläche liegt direkt auf https://ginos.de
FAHRSTUNDEN_BASIS_PFAD=/

FAHRSTUNDEN_APP_NAME=Ginos
FAHRSTUNDEN_FAHRSCHULE=Fahrschule mit Herz

# Zeit, die der FS Manager pro Eintragetag zulässt.
FAHRSTUNDEN_TAGESLIMIT_MINUTEN=495
