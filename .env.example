# Beispiel-Umgebung für die Insider-API. Kopieren nach .env (wird NICHT committet).

# HTTP-Port
PORT=8080

# Datenbank (App-User, nur DML-Rechte)
DATABASE_URL=postgres://insider_app:insider_dev_pw@127.0.0.1:5432/insider_dev

# JWT-Secret (PFLICHT, mind. 16 Zeichen). In Produktion ein langes Zufallsgeheimnis!
JWT_SECRET=bitte-langes-zufaelliges-secret-setzen
JWT_TTL=24h

# E-Mail-Verifizierung erzwingen (Login nur mit bestätigter E-Mail)
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL=48h

# Rate-Limit pro IP/Minute auf Schreib-Endpoints
RATE_LIMIT_PER_MINUTE=20

# Vertrauenswürdige Proxys (Komma-getrennt), z. B. 127.0.0.1. Leer = keinem vertrauen.
TRUSTED_PROXIES=

# Fidolin-Worker (KI-Moderation)
FIDOLIN_WORKERS=2
FIDOLIN_BATCH_SIZE=10
FIDOLIN_POLL_INTERVAL=2s
FIDOLIN_STALE_AFTER=5m

# Optionale Blockliste (Komma-getrennt). Leer = eingebauter Default.
MODERATION_BLOCKLIST=

# ------------------------------------------------------------------
# Fahrstunden-Nachweis (Nebenbuch zum FS Manager) — siehe FAHRSTUNDEN.md
# ------------------------------------------------------------------

# Zeit, die der FS Manager pro Eintragetag zulässt (8 h 15 min).
FAHRSTUNDEN_TAGESLIMIT_MINUTEN=495

# URL der Oberfläche. Frei wählbar — z. B. /gino für einen eigenen Namen.
FAHRSTUNDEN_BASIS_PFAD=/fahrstunden

# Name in Titelzeile und Kopf der Oberfläche.
FAHRSTUNDEN_APP_NAME=Fahrstunden-Nachweis

# Kopfzeile im PDF-Nachweis (leer = keine).
FAHRSTUNDEN_FAHRSCHULE=
